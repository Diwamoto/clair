+    /// Cancels all queued and running parser work and completes after the
+    /// executor becomes idle. The client is terminal after close and must not
+    /// be reused; create a new client when a document is displayed again.
+    @MainActor
+    public func close(completion: @escaping @MainActor (Bool) -> Void) {
+        guard !isClosed else {
+            completion(state == nil)
+            return
+        }
+        isClosed = true
+        executor.close { [self] in
+            DispatchQueue.main.async {
+                self.state = nil
+                self.readBlock = nil
+                self.readCallback = nil
+                self.oldEndPoint = nil
+                self.pendingEdits.mutate { $0.removeAll() }
+                completion(true)
+            }
+        }
+    }
