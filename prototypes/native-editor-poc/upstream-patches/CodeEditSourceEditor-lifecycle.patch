+    /// item has left the executor. Running operations are cooperative: the
+    /// completion is intentionally delayed until the operation returns.
+    func close(completion: @escaping () -> Void) {
+        let completions: [() -> Void] = lock.withLock {
+            closeCompletions.append(completion)
+            isClosing = true
