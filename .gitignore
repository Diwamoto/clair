# macOS
.DS_Store

# Xcode and local Swift state
/.build/
/packages/*/.build/
/DerivedData/
*.xcresult
*.xcuserstate
xcuserdata/

# Python
__pycache__/

# Generated bindings and intermediates
/generated/
/.tmp/

# Standalone docs site project (own repo, own remote — not part of this history).
/docs-site/

# Materialized libghostty/GhosttyKit vendor artifact and its build/fetch
# cache (Config/ghostty-pin.json is the tracked source of truth; see
# scripts/ghostty.sh and docs/plans/clair-t01-libghostty-foundation.md).
/packages/ClairCore/Vendor/ghostty
/.cache/ghostty/
/ClairMobile.xcodeproj/project.xcworkspace/

# Per-developer signing (Apple Team ID); see Config/Signing.xcconfig.
/Config/Signing.local.xcconfig
